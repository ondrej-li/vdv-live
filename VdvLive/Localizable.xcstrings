      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkusit znovu"
          }
        }
      }
    },
    "No pinned lines yet. Tap the star to pin a line number, or tap a vehicle on the map and use its star.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné oblíbené linky. Klepněte na hvězdičku a přidejte číslo linky, nebo klepněte na vozidlo na mapě a použijte jeho hvězdičku."
          }
        }
      }
    },
    "Your pinned lines are not in this part of the map.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše oblíbené linky nejsou v této části mapy."
          }
        }
      }
    },
    "Show line %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit linku %@"
          }
        }
      }
    },
    "None of your pinned lines are running right now.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z vašich oblíbených linek momentálně nic nejede."
          }
        }
      }
    },
    "No vehicles in this part of the map.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V této části mapy nejsou žádná vozidla."
          }
        }
      }
    },
    "The feed is not reporting any vehicles at the moment.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdroj dat momentálně nehlásí žádná vozidla."
          }
        }
      }
    },
