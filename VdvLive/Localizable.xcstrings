    "No line is on this phone yet" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V telefonu zatím není žádná linka"
          }
        }
      }
    },
    "A line is downloaded the first time something needs it: a vehicle's card, a stop's board, or the setting that fills in lines the feed leaves out." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linka se stáhne, jakmile ji něco potřebuje: karta vozidla, tabule zastávky nebo volba, která doplňuje linky, o kterých mlčí poloha."
          }
        }
      }
    },
    "One row per line whose timetable can be read without the network." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řádek pro každou linku, jejíž jízdní řád jde přečíst i bez sítě."
          }
        }
      }
    },
    "Files on disk" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubory na disku"
          }
        }
      }
    },
    "The archive entry each line was read out of. The ministry renumbers these names every time it republishes, so a file can declare a different line than the one it was downloaded for." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položka archivu, ze které se linka četla. Ministerstvo při každém zveřejnění tato jména přečísluje, takže soubor může hlásit jinou linku, než pro kterou se stáhl."
          }
        }
      }
    },
