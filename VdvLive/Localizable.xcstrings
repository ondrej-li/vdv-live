    "Running now": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě jede"
          }
        }
      }
    },
    "Find a line that is running": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najít linku, která právě jede"
          }
        }
      }
    },
    "not running": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "nejede"
          }
        }
      }
    },
    "no vehicles right now": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "momentálně žádná vozidla"
          }
        }
      }
    },
    "%@ · operator %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · dopravce %@"
          }
        }
      }
    },
    "Show only pinned lines on the map": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit na mapě jen oblíbené linky"
          }
        }
      }
    },
    "Everything else stays hidden, which is easier on the eye when all you care about is one line. This is remembered for the next launch.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše ostatní zůstane skryté, což je přehlednější, když vás zajímá jediná linka. Volba se pamatuje i pro příští spuštění."
          }
        }
      }
    },
    "No pinned lines yet. Pin one here, or tap a vehicle on the map and use the star.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné oblíbené linky. Přidejte je tady, nebo klepněte na vozidlo na mapě a použijte hvězdičku."
          }
        }
      }
    },
    "Use the number the map shows, for example 420. A pinned line stays in the list even when it is not running.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte číslo, které ukazuje mapa, například 420. Oblíbená linka zůstane v seznamu, i když právě nejede."
          }
        }
      }
    },
    "No running line matches “%@”.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná jedoucí linka neodpovídá „%@“."
          }
        }
      }
    },
    "Refresh": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace"
          }
        }
      }
    },
    "Automatic refresh": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatická aktualizace"
          }
        }
      }
    },
    "Refresh interval": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Interval aktualizace"
          }
        }
      }
    },
    "The feed reports new positions every few seconds. Asking for them more often than every %lld s only costs battery.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdroj dat hlásí nové polohy každých pár sekund. Častější dotazy než každých %lld s jen spotřebovávají baterii."
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémové"
          }
        }
      }
    },
    "Czech is the default. A language change takes effect the next time the app starts.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí je čeština. Změna jazyka se projeví při příštím spuštění aplikace."
          }
        }
      }
    },
    "Open at my location": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřít na mé poloze"
          }
        }
      }
    },
    "Show my position on the map": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit moji polohu na mapě"
          }
        }
      }
    },
    "My location": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje poloha"
          }
        }
      }
    },
    "Clear saved view": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit uložený výřez"
          }
        }
      }
    },
    "The position is read on the device and never sent anywhere. The blue dot is the system's own; the map opens about 10 km around the position, and the lock button remembers the view you are looking at instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poloha se načítá v zařízení a nikam se neposílá. Modrá tečka je systémová; mapa se otevře zhruba 10 km okolo polohy a tlačítkem se zámkem si místo toho uložíte právě zobrazený výřez."
          }
        }
      }
    },
    "Vehicles": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vozidla"
          }
        }
      }
    },
    "Group buses within": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seskupovat autobusy blíž než"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto"
          }
        }
      }
    },
    "Buses closer together than this share one marker, which keeps a busy region readable when it is zoomed out. Off, every vehicle is drawn on its own.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Autobusy blíž k sobě než tato vzdálenost sdílejí jeden marker, takže zůstane přeplněný kraj čitelný i při oddálení. Po vypnutí se každé vozidlo kreslí zvlášť."
          }
        }
      }
    },
    "Timetables": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jízdní řády"
          }
        }
      }
    },
    "Download timetables": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhnout jízdní řády"
          }
        }
      }
    },
    "Download again": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhnout znovu"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat"
          }
        }
      }
    },
    "Downloaded": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Staženo"
          }
        }
      }
    },
    "Lines": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Linek"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "Reading the timetable index…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítám index jízdních řádů…"
          }
        }
      }
    },
    "Downloads the index of the official timetable archive (a couple of megabytes), so the selected vehicle can list all of its stops with the times they are actually expected. Each line's timetable is then fetched on its own, a few kilobytes at a time.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne index oficiálního archivu jízdních řádů (několik megabajtů), díky kterému umí vybrané vozidlo vypsat všechny své zastávky s časy, které se skutečně očekávají. Jízdní řád jednotlivé linky se pak stahuje zvlášť, po několika kilobajtech."
          }
        }
      }
    },
    "All stops": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny zastávky"
          }
        }
      }
    },
    "on request": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "na znamení"
          }
        }
      }
    },
    "no recent data": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "bez čerstvých dat"
          }
        }
      }
    },
    "No recent data for this vehicle.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O tomto vozidle nemáme čerstvá data."
          }
        }
      }
    },
    "Looking up the timetable…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjišťuji jízdní řád…"
          }
        }
      }
    },
    "Timetables have not been downloaded yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jízdní řády ještě nejsou stažené."
          }
        }
      }
    },
    "The timetable server refused a partial download.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server jízdních řádů odmítl částečné stažení."
          }
        }
      }
    },
    "The timetable server sent an unexpected response.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server jízdních řádů poslal neočekávanou odpověď."
          }
        }
      }
    },
    "Line %@ is not in the published timetable.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
