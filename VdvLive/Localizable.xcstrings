    "No pinned lines yet. Pin a line number in Settings, or tap a vehicle on the map and use its star.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné oblíbené linky. Přidejte číslo linky v Nastavení, nebo klepněte na vozidlo na mapě a použijte jeho hvězdičku."
          }
        }
      }
    },
    "Your pinned lines are not in this part of the map.": {
      "localizations": {
