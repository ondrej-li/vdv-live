    "Source files" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdrojové soubory"
          }
        }
      }
    },
    "This copy came from an earlier publication of the archive: the entry it lives in has since been renumbered, so it is read from the file cached on this phone. It is still a timetable, but it may have been replaced." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato kopie pochází z dřívějšího zveřejnění archivu: položka, ve které bydlí, byla od té doby přečíslována, takže se čte ze souboru uloženého v telefonu. Pořád je to jízdní řád, ale mohl být nahrazen."
          }
        }
      }
    },
    "The JDF tables inside the archive entry, exactly as the ministry published them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulky JDF uvnitř položky archivu, přesně jak je ministerstvo zveřejnilo."
          }
        }
      }
    },
    "One row per service of the line, in the order they leave the first stop." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řádek pro každý spoj linky, v pořadí, v jakém vyjíždějí z první zastávky."
